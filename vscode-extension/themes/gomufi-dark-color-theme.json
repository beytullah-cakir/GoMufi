  "tokenColors": [
    {
      "name": "Yorumlar",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#6b7899", "fontStyle": "italic" }
    },
    {
      "name": "Değişkenler",
      "scope": ["variable", "meta.definition.variable.name", "support.variable", "string constant.other.placeholder"],
      "settings": { "foreground": "#e2e8f0" }
    },
    {
      "name": "Parametreler",
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#fda4af", "fontStyle": "italic" }
    },
    {
      "name": "Nesne özellikleri",
      "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": { "foreground": "#67e8f9" }
    },
    {
      "name": "Sabitler ve sayılar",
      "scope": ["constant", "constant.numeric", "constant.language", "keyword.other.unit", "variable.other.constant"],
      "settings": { "foreground": "#f0abfc" }
    },
    {
      "name": "Metinler",
      "scope": ["string", "string.quoted", "constant.character", "punctuation.definition.string"],
      "settings": { "foreground": "#86efac" }
    },
    {
      "name": "Kaçış dizileri",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#fde047" }
    },
    {
      "name": "Anahtar sözcükler",
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.other"],
      "settings": { "foreground": "#c4b5fd" }
    },
    {
      "name": "İşleçler",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#94a3b8" }
    },
    {
      "name": "Fonksiyonlar",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"],
      "settings": { "foreground": "#7dd3fc" }
    },
    {
      "name": "Sınıflar ve tipler",
      "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.class", "support.type", "entity.name.namespace"],
      "settings": { "foreground": "#f0abfc" }
    },
    {
      "name": "Dekoratörler",
      "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#fb923c", "fontStyle": "italic" }
    },
    {
      "name": "HTML/JSX etiketleri",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#e879f9" }
    },
    {
      "name": "Etiket öznitelikleri",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#fde047", "fontStyle": "italic" }
    },
    {
      "name": "CSS seçicileri",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css"],
      "settings": { "foreground": "#7dd3fc" }
    },
    {
      "name": "Markdown başlıkları",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#38bdf8", "fontStyle": "bold" }
    },
    {
      "name": "Markdown kalın/eğik",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#f0abfc", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#c4b5fd", "fontStyle": "italic" }
    },
    {
      "name": "Markdown bağlantı ve kod",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#67e8f9", "fontStyle": "underline" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "#86efac" }
    },
    {
      "name": "Diff",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#86efac" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#f87171" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#fde047" }
    },
    {
      "name": "Geçersiz",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#f87171", "fontStyle": "italic underline" }
    },
    {
      "name": "self / this",
      "scope": ["variable.language.self", "variable.language.this", "variable.language.special"],
      "settings": { "foreground": "#c4b5fd", "fontStyle": "italic" }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#fda4af",
    "property": "#67e8f9",
    "class": "#f0abfc",
    "enum": "#f0abfc",
    "interface": "#f0abfc",
    "type": "#f0abfc",
    "function": "#7dd3fc",
    "method": "#7dd3fc",
    "namespace": "#c4b5fd",
    "selfParameter": "#c4b5fd",
    "variable.readonly": "#f0abfc",
    "*.decorator": "#fb923c"
  }
}
