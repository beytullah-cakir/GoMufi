{
  "name": "gomufi",
  "displayName": "GoMufi",
  "description": "GoMufi derslerini VS Code'da aç: kodu kendi bilgisayarında yaz, çalıştır, ödevini teslim et.",
  "version": "0.6.0",
  "publisher": "gomufi",
  "icon": "media/icon.png",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://go-mufi.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/beytullah-cakir/GoMufi.git"
  },
  "bugs": {
    "email": "destek@gomufi.com"
  },
  "keywords": [
    "gomufi",
    "eğitim",
    "education",
    "python",
    "öğrenci",
    "ders"
  ],
  "galleryBanner": {
    "color": "#0ea5e9",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Education",
    "Themes",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Kısıtlı Mod'da dersler ve ödevler görüntülenebilir; kod çalıştırmak için klasöre güvenmen gerekir."
    }
  },
  "contributes": {
    "themes": [
      {
        "label": "GoMufi Karanlık",
        "uiTheme": "vs-dark",
        "path": "./themes/gomufi-dark-color-theme.json"
      },
      {
        "label": "GoMufi Aydınlık",
        "uiTheme": "vs",
        "path": "./themes/gomufi-light-color-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gomufi",
          "title": "GoMufi",
          "icon": "media/gomufi.svg"
        }
      ]
    },
    "views": {
      "gomufi": [
        {
          "id": "gomufi.assignments",
          "name": "Ödevlerim",
          "when": "gomufi.view == student"
        },
        {
          "id": "gomufi.submissions",
          "name": "Gelen Teslimler",
          "when": "gomufi.view == teacher"
        },
        {
          "id": "gomufi.welcome",
          "name": "GoMufi",
          "when": "gomufi.view != student && gomufi.view != teacher"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gomufi.welcome",
        "when": "!gomufi.signedIn",
        "contents": "Derslerine başlamak için GoMufi hesabınla giriş yap. Giriş tarayıcıda yapılır; parolan VS Code'a girilmez.\n\n[Giriş Yap](command:gomufi.signIn)\n\nVS Code'u GoMufi görünümüne çevirmek istersen:\n\n[Tasarımı Uygula](command:gomufi.applyTheme)"
      },
      {
        "view": "gomufi.welcome",
        "when": "gomufi.signedIn",
        "contents": "Bu hesabın rolü VS Code eklentisinde henüz desteklenmiyor.\n\nÖdev görmek için öğrenci, teslim görmek için öğretmen hesabıyla gir.\n\n[Çıkış Yap](command:gomufi.signOut)"
      }
    ],
    "commands": [
      {
        "command": "gomufi.signIn",
        "title": "GoMufi: Giriş Yap"
      },
      {
        "command": "gomufi.signOut",
        "title": "GoMufi: Çıkış Yap"
      },
      {
        "command": "gomufi.openLessons",
        "title": "GoMufi: Dersleri Aç",
        "icon": "$(book)"
      },
      {
        "command": "gomufi.changeRoot",
        "title": "GoMufi: Ders Klasörünü Değiştir",
        "icon": "$(folder)"
      },
      {
        "command": "gomufi.refresh",
        "title": "Yenile",
        "icon": "$(refresh)"
      },
      {
        "command": "gomufi.applyTheme",
        "title": "GoMufi: Tasarımı Uygula (Tema ve Yazı Tipleri)",
        "icon": "$(symbol-color)"
      },
      {
        "command": "gomufi.growLesson",
        "title": "GoMufi: Ders Panelini Genişlet (%10)",
        "icon": "$(chevron-left)"
      },
      {
        "command": "gomufi.growEditor",
        "title": "GoMufi: Kod Ekranını Genişlet (%10)",
        "icon": "$(chevron-right)"
      },
      {
        "command": "gomufi.resetLayout",
        "title": "GoMufi: Panel Genişliğini Sıfırla",
        "icon": "$(discard)"
      },
      {
        "command": "gomufi.openAssignment",
        "title": "Ödevi Aç"
      },
      {
        "command": "gomufi.submitAssignment",
        "title": "GoMufi: Ödevi Teslim Et",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gomufi.openSubmission",
        "title": "Teslimi İncele"
      },
      {
        "command": "gomufi.gradeSubmission",
        "title": "GoMufi: Not Ver",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gomufi.signIn",
          "when": "!gomufi.signedIn"
        },
        {
          "command": "gomufi.signOut",
          "when": "gomufi.signedIn"
        },
        {
          "command": "gomufi.refresh",
          "when": "false"
        },
        {
          "command": "gomufi.openAssignment",
          "when": "false"
        },
        {
          "command": "gomufi.openSubmission",
          "when": "false"
        },
        {
          "command": "gomufi.gradeSubmission",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "gomufi.openLessons",
          "when": "view == gomufi.welcome && gomufi.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "gomufi.openLessons",
          "when": "view == gomufi.assignments",
          "group": "navigation@1"
        },
        {
          "command": "gomufi.refresh",
          "when": "view == gomufi.assignments || view == gomufi.submissions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "gomufi.submitAssignment",
          "when": "view == gomufi.assignments && viewItem == assignment",
          "group": "inline"
        },
        {
          "command": "gomufi.gradeSubmission",
          "when": "view == gomufi.submissions && viewItem == submission",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gomufi.growLesson",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+."
      },
      {
        "command": "gomufi.growEditor",
        "key": "ctrl+alt+,",
        "mac": "cmd+alt+,"
      },
      {
        "command": "gomufi.resetLayout",
        "key": "ctrl+alt+0",
        "mac": "cmd+alt+0"
      }
    ],
    "configuration": {
      "title": "GoMufi",
      "properties": {
        "gomufi.apiUrl": {
          "type": "string",
          "default": "https://gomufi-backend.onrender.com",
          "description": "GoMufi sunucu (API) adresi. Yalnızca kendi kurulumunuz ya da geliştirme için değiştirin (ör. http://localhost:8000)."
        },
        "gomufi.allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Yerel çalıştırıcıya erişebilecek EK site adresleri. Varsayılan GoMufi adresleri zaten izinlidir; buraya yalnızca kendi kurulumunuzun adresini ekleyin."
        },
        "gomufi.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "Derslerin, ödevlerin ve kodlarının durduğu klasör. Boş bırakılırsa ev dizinindeki 'GoMufi' klasörü kullanılır. \"GoMufi: Ders Klasörünü Değiştir\" komutuyla da seçilebilir."
        },
        "gomufi.siteUrl": {
          "type": "string",
          "default": "https://go-mufi.vercel.app",
          "description": "GoMufi site adresi. Giriş ve ders paneli bu adresten açılır. Geliştirmede: http://localhost:5173"
        },
        "gomufi.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "\"GoMufi: Tasarımı Uygula\" komutunun kuracağı kod yazı tipi. Boş bırakılırsa `Cascadia Code → JetBrains Mono → Fira Code → Consolas` sırası kullanılır."
        },
        "gomufi.fontSize": {
          "type": "number",
          "default": 15,
          "minimum": 10,
          "maximum": 28,
          "markdownDescription": "Editör yazı boyutu. Terminal ve hata ayıklama konsolu bunun bir punto altını kullanır. Ders anlatırken 17-18 rahat okunur."
        },
        "gomufi.labMode": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "**Laboratuvar modu** (okuldaki ortak bilgisayarlar için): VS Code kapanınca oturum kapanır ve her öğrencinin dosyaları ders klasörünün altında kendi klasöründe durur. Öğretmen/BT sorumlusu açar."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "tsc -p ./ && node --test out/test/*.test.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.97.0",
    "typescript": "^5.4.0"
  }
}
