# Frontend ortam değişkenleri örneği. Gerçek değerler için bu dosyayı `.env` olarak kopyalayın.
# (.env git tarafından yok sayılır — sırlar commit edilmez.)

# Backend API adresi. Boşsa otomatik olarak window.location host'undan :8000 türetilir.
VITE_API_URL=

# PostHog analytics + hata takibi (opsiyonel).
# Tanımlı DEĞİLSE analytics tamamen devre dışı kalır, uygulama normal çalışır.
# KVKK: host EU tutulmalı (veri AB'de). Anahtar public'tir, client-side olması normaldir.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
