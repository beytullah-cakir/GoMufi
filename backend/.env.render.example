# ============================================================
#  GoMufi — Render.com Production Environment Variables
#  Bu dosya Render Dashboard'a elle girilecek değerlerin şablonudur.
#  ASLA gerçek değerlerle birlikte commit etme!
# ============================================================

# ── Temel Güvenlik ──────────────────────────────────────────
# render.yaml'da generateValue: true ile otomatik üretilir
SECRET_KEY=<render-otomatik-üretir-veya-buraya-gir>

# ── Veritabanı (Supabase) ────────────────────────────────────
# Supabase Project Settings → Database → Connection String (URI)
# Session pooler kullan (port 5432 — Alembic uyumlu)
DATABASE_URL=postgresql://postgres.<proje-ref>:<şifre>@aws-<bölge>.pooler.supabase.com:5432/postgres

# ── Frontend URL ─────────────────────────────────────────────
FRONTEND_URL=https://go-mufi.vercel.app

# ── Google OAuth ─────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URIs'a şunu ekle:
#   https://<render-backend-url>/auth/google/callback
GOOGLE_CLIENT_ID=<google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-<gizli-anahtar>

# ── İyzico Ödeme ─────────────────────────────────────────────
# Sandbox için:
IYZICO_API_KEY=sandbox-<api-key>
IYZICO_SECRET_KEY=sandbox-<secret-key>
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Production için:
# IYZICO_API_KEY=<production-api-key>
# IYZICO_SECRET_KEY=<production-secret-key>
# IYZICO_BASE_URL=https://api.iyzipay.com

# ── Gemini AI ────────────────────────────────────────────────
MY_API_KEY=<gemini-api-key>

# ── Jitsi JaaS ───────────────────────────────────────────────
JITSI_APP_ID=vpaas-magic-cookie-<id>
JITSI_API_KEY=vpaas-magic-cookie-<id>/<key-id>
JITSI_DOMAIN=8x8.vc
# JITSI_APP_SECRET multiline private key — Render'da "Paste" ile gir:
JITSI_APP_SECRET=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ── Token Süreleri ────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Admin Hesabı ─────────────────────────────────────────────
ADMIN_EMAIL=admin@gomufi.com
ADMIN_PASSWORD=<güçlü-şifre-gir>

# ── BACKEND_URL (OPSİYONEL) ──────────────────────────────────
# Render RENDER_EXTERNAL_URL'yi otomatik inject eder, bu yüzden
# çoğu durumda BACKEND_URL'yi elle girmen gerekmez.
# Ancak özel domain kullanıyorsan:
# BACKEND_URL=https://api.gomufi.com

# ── REDIS_URL (OPSİYONEL) ────────────────────────────────────
# Şu an kullanılmıyor. WebSocket single-instance local mod ile çalışıyor.
# Eğer Upstash Redis eklemek istersen:
# REDIS_URL=rediss://:<token>@<upstash-host>:6380
